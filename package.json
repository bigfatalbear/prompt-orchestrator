{
  "name": "prompt-orchestrator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Transforme uma ideia em uma especificação profissional pronta para agentes de IA.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @po/web",
    "build": "npm run build -w @po/web",
    "preview": "npm run preview -w @po/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "desktop:dev": "npm run tauri dev -w @po/desktop",
    "desktop:build": "npm run tauri build -w @po/desktop"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.0",
    "fake-indexeddb": "^6.0.1",
    "prettier": "^3.5.3",
    "typescript": "^5.7.3",
    "tailwindcss": "^3.4.17",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.9"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "idb": "^8.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
