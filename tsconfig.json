{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "vite-plugin-pwa/client", "vitest/globals", "node"],
    "baseUrl": ".",
    "paths": {
      "@po/types": ["packages/types/src/index.ts"],
      "@po/core": ["packages/core/src/index.ts"],
      "@po/rules-engine": ["packages/rules-engine/src/index.ts"],
      "@po/validation": ["packages/validation/src/index.ts"],
      "@po/prompt-engine": ["packages/prompt-engine/src/index.ts"],
      "@po/storage": ["packages/storage/src/index.ts"],
      "@po/ai": ["packages/ai/src/index.ts"],
      "@po/ui": ["packages/ui/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "tests/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
